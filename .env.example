# SafetyOps Copilot example environment variables
# Copy this file to .env and adjust values as needed.

SAFETYOPS_APP_NAME=SafetyOps Copilot
SAFETYOPS_APP_VERSION=0.1.0
SAFETYOPS_ENV=local
SAFETYOPS_LOG_LEVEL=INFO
SAFETYOPS_DEPLOY_MODE=local

# Streaming / Redis
SAFETYOPS_REDIS_URL=redis://localhost:6379
SAFETYOPS_STREAM_KEY=safetyops:events
SAFETYOPS_CONSUMER_GROUP=safetyops-workers
SAFETYOPS_CONSUMER_NAME=worker-1
SAFETYOPS_DLQ_STREAM_KEY=safetyops:events:dlq

# Database (local development only; do not use these credentials in production)
# For Docker-based local development (see infra/docker-compose.local.yml):
SAFETYOPS_DATABASE_URL=postgresql+psycopg2://safetyops:safetyops@localhost:5432/safetyops
# For a quick demo without Docker/Postgres, you can instead use:
# SAFETYOPS_DATABASE_URL=sqlite:///./safetyops.db

# MLflow tracking
SAFETYOPS_MLFLOW_TRACKING_URI=http://localhost:5000

# Artifacts and models
SAFETYOPS_ARTIFACTS_DIR=artifacts
SAFETYOPS_NLP_MODEL_DIR=models/nlp
# PPE-capable weights (recommended): run `python scripts/download_vision_model.py`
# and use models/vision/ppe_yolov8n.pt. The default COCO yolov8n.pt can only
# count persons, so compliance stays neutral with it.
SAFETYOPS_VISION_MODEL_PATH=models/vision/ppe_yolov8n.pt

# Optional LLM for Copilot report enhancement (any OpenAI-compatible endpoint).
# Groq (free tier):
# SAFETYOPS_LLM_BASE_URL=https://api.groq.com/openai
# SAFETYOPS_LLM_API_KEY=gsk_...
# SAFETYOPS_LLM_MODEL=llama-3.3-70b-versatile
# Local Ollama (no API key needed):
# SAFETYOPS_LLM_BASE_URL=http://localhost:11434
# SAFETYOPS_LLM_MODEL=llama3

# UI configuration
# Base URL for the FastAPI service that the Streamlit UI should call.
# In local development this is usually http://localhost:8000.
SAFETYOPS_API_BASE_URL=http://localhost:8000

# API protection (both optional; recommended for public deployments)
# When set, write endpoints require the X-API-Key header (the UI forwards it
# automatically if the same variable is set in its environment).
# SAFETYOPS_API_KEY=change-me
# Max protected requests per client IP per minute (0 = disabled).
# SAFETYOPS_RATE_LIMIT_PER_MINUTE=30

# Metrics
SAFETYOPS_METRICS_NAMESPACE=safetyops