# SafetyOps Copilot example environment variables
# Copy this file to .env and adjust values as needed.

SAFETYOPS_APP_NAME=SafetyOps Copilot
SAFETYOPS_APP_VERSION=0.1.0
SAFETYOPS_ENV=local
SAFETYOPS_LOG_LEVEL=INFO

# Streaming / Redis
SAFETYOPS_REDIS_URL=redis://localhost:6379
SAFETYOPS_STREAM_KEY=safetyops:events
SAFETYOPS_CONSUMER_GROUP=safetyops-workers
SAFETYOPS_CONSUMER_NAME=worker-1

# Database (local development only; do not use these credentials in production)
SAFETYOPS_DATABASE_URL=postgresql+psycopg2://safetyops:safetyops@localhost:5432/safetyops

# MLflow tracking
SAFETYOPS_MLFLOW_TRACKING_URI=http://localhost:5000

# Metrics
SAFETYOPS_METRICS_NAMESPACE=safetyops